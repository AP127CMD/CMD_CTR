# Copy this file to .env (same directory) and fill in the real value.
# .env is gitignored — never commit the real token.

# Fine-grained GitHub PAT — same scope pattern as the existing GH_PAT_WORKFLOW
# secret CI already uses (see CMDV2/CLAUDE.md "PAT rotated to fine-grained").
# Needs:
#   - AP127CMD/CMD_CTR:  Contents  — Read and write
#   - AP127CMD/CMDV2:    Actions   — Read and write  (to dispatch refresh-data.yml)
# Create at: https://github.com/settings/personal-access-tokens/new
GH_PAT=
