# Copy to pi-native/.env on the Pi (chmod 600). Never commit the real value —
# this file is gitignored.

# Fine-grained GitHub PAT, same scopes as docker/.env.example, PLUS Issues
# (added 2026-08-29 for the fetch-failure-pi alerting in run_fetch.sh):
#   - AP127CMD/CMD_CTR:  Contents  — Read and write
#   - AP127CMD/CMD_CTR:  Issues    — Read and write
#   - AP127CMD/CMDV2:    Actions   — Read and write
# Create at: https://github.com/settings/personal-access-tokens/new
GH_PAT=

# API key for the watchdog's POST /notify push endpoint (same value as the
# ap127-watchdog Worker's NOTIFY_KEY secret). Optional — without it the
# watchdog still catches changes on its */2 cron, just ~1-2 min slower.
WATCHDOG_NOTIFY_KEY=

# API key for the dead-man's-switch monitor's POST /pi-heartbeat endpoint (same value
# as the ap127-watchdog-monitor Worker's PI_HEARTBEAT_KEY secret, set via
# `cd AP127_V2/watchdog-monitor && npx wrangler secret put PI_HEARTBEAT_KEY`). Optional
# but recommended (added 2026-09-12) — without it, a Pi that goes fully offline (not just
# standing by) is invisible: the cloud fallback keeps flight data fresh and masks it
# completely. With it, evaluatePi() in watchdog-monitor/src/index.js pages within
# ~20-30 min of the Pi actually going dark.
PI_HEARTBEAT_KEY=
