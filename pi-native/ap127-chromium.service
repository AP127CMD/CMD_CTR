[Unit]
Description=AP127 persistent authenticated Chromium (headless, Xvfb on :99)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__HOME__/flight-schedule-feed/pi-native
ExecStart=__HOME__/flight-schedule-feed/pi-native/start-chromium.sh
Restart=on-failure
RestartSec=10
KillMode=control-group
# Chrome's own OOM-avoidance can be aggressive; give the OS's own oom-killer
# a slightly better shot at picking something else first if it ever comes to
# that (still not a substitute for zram/swap — see README.md).
OOMScoreAdjust=100

[Install]
WantedBy=multi-user.target
