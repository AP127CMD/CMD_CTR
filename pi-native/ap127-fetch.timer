[Unit]
Description=Run ap127-fetch every 5 minutes

[Timer]
OnBootSec=2min
# 2026-09-06: briefly ran at 3 min (Phase 2, paired with FETCH_RPC_CONCURRENCY).
# Reverted to 5 min on 2026-09-07 after the Pi hard-hung ~4 h into the 3-min
# cadence (board powered but fully unresponsive — likely OOM / lockout under the
# tighter memory-spike interval on a 1 GB board also running CUPS). The parallel
# scrape (concurrency) is kept — it is the real speed win; only the interval
# reverted, to give the board idle-recovery time between heavy cycles.
OnUnitActiveSec=5min
# Spread slightly so it doesn't always land exactly when ap127-chromium.service
# might be mid-restart after a crash.
AccuracySec=30sec

[Install]
WantedBy=timers.target
