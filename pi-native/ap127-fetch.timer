[Unit]
Description=Run ap127-fetch every 3 minutes

[Timer]
OnBootSec=2min
# Phase 2 (2026-09-06): 5 -> 3 min. The per-date RPC loop now runs in parallel
# (FETCH_RPC_CONCURRENCY) so a full window is ~3-4 min. oneshot means cycles
# never overlap — a fetch still in progress just delays the next, it doesn't
# stack. Revert to 5min + STANDBY_MAX_AGE_MIN=6 if Google bot-detection reacts.
OnUnitActiveSec=3min
# Spread slightly so it doesn't always land exactly when ap127-chromium.service
# might be mid-restart after a crash.
AccuracySec=30sec

[Install]
WantedBy=timers.target
